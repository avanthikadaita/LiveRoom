{
  "name": "FitCheck-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:fixtures": "DATABASE_URL=pglite://fixtures DATABASE_URL_DEMO=pglite://fixtures next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evals": "tsx mastra/evals/run.ts",
    "seed:fixtures": "tsx scripts/seed-fixtures.ts",
    "snapshot": "tsx scripts/build-snapshot.ts",
    "live-check": "tsx scripts/live-check.ts",
    "test:e2e:broken-db": "E2E_BROKEN_DB=1 playwright test",
    "studio": "mastra dev --dir mastra",
    "corner-check": "tsx scripts/corner-check.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "@google/model-viewer": "^4.4.0",
    "@mastra/core": "^1.83.0",
    "@mastra/memory": "^1.41.1",
    "@mastra/pg": "^1.36.0",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
